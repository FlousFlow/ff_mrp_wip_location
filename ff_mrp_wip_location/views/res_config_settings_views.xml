<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff_mrp_wip_location" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ff.mrp.wip.location</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="mrp_byproduct" position="after">
                <setting id="ff_wip_location" string="Work in Progress Location"
                         help="Main finished products marked Under Processing are stored here."
                         title="This must be an active internal location belonging to the current company or shared between companies.">
                    <field name="ff_wip_location_id" options="{'no_create': True}"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
